.................... // Helper functions  
....................  
.................... unsigned int8 bcd_to_decimal(unsigned int8 bcd) { 
*
024E:  SWAPF  42,W
024F:  MOVWF  77
0250:  MOVLW  0F
0251:  ANDWF  77,F
0252:  MOVF   77,W
0253:  ANDLW  0F
0254:  MOVWF  43
0255:  MOVF   42,W
0256:  ANDLW  0F
0257:  MOVWF  44
....................     int tens = (bcd >> 4) & 0x0F; 
....................     int units = bcd & 0x0F; 
....................     return tens * 10 + units; 
0258:  MOVF   43,W
0259:  MOVWF  45
025A:  MOVLW  0A
025B:  MOVWF  46
*
0280:  MOVF   44,W
0281:  ADDWF  78,W
0282:  MOVWF  78
0283:  RETURN
.................... } 
....................  
.................... unsigned int8 decimal_to_bcd(unsigned int8 decimal) { 
*
078F:  MOVF   3B,W
0790:  MOVWF  40
0791:  MOVLW  0A
0792:  MOVWF  41
0793:  CALL   38F
0794:  MOVF   78,W
0795:  MOVWF  3C
0796:  MOVF   3B,W
0797:  MOVWF  40
0798:  MOVLW  0A
0799:  MOVWF  41
079A:  CALL   38F
079B:  MOVF   77,W
079C:  MOVWF  3D
....................     unsigned int8 tens = decimal / 10; 
....................     unsigned int8 units = decimal % 10; 
....................     return (tens << 4) | units; 
079D:  SWAPF  3C,W
079E:  MOVWF  77
079F:  MOVLW  F0
07A0:  ANDWF  77,F
07A1:  MOVF   77,W
07A2:  IORWF  3D,W
07A3:  MOVWF  78
07A4:  RETURN
.................... } 
