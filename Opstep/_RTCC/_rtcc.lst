.................... #ifndef __LCD_C__ 
.................... #define __LCD_C__ 
....................  
.................... // define the pinout. 
.................... // only required if port access is being used. 
.................... typedef struct   
.................... {                            // This structure is overlayed 
....................    int1 enable;           // on to an I/O port to gain 
....................    int1 rs;               // access to the LCD pins. 
....................    int1 rw;               // The bits are allocated from 
....................    int1 unused;           // low order up.  ENABLE will 
....................    unsigned int     data : 4;         // be LSB pin of that port. 
....................   #if defined(__PCD__)       // The port used will be LCD_DATA_PORT. 
....................    unsigned int    reserved: 8; 
....................   #endif 
.................... } LCD_PIN_MAP; 
....................  
.................... // this is to improve compatability with previous LCD drivers that accepted 
.................... // a define labeled 'use_portb_lcd' that configured the LCD onto port B. 
.................... #if ((defined(use_portb_lcd)) && (use_portb_lcd==TRUE)) 
....................  #define LCD_DATA_PORT getenv("SFR:PORTB") 
.................... #endif 
....................  
.................... #if defined(__PCB__) 
....................    // these definitions only need to be modified for baseline PICs. 
....................    // all other PICs use LCD_PIN_MAP or individual LCD_xxx pin definitions. 
.................... /*                                    EN, RS,   RW,   UNUSED,  DATA  */ 
....................  const LCD_PIN_MAP LCD_OUTPUT_MAP =  {0,  0,    0,    0,       0}; 
....................  const LCD_PIN_MAP LCD_INPUT_MAP =   {0,  0,    0,    0,       0xF}; 
.................... #endif 
....................  
.................... ////////////////////// END CONFIGURATION /////////////////////////////////// 
....................  
.................... #ifndef LCD_ENABLE_PIN 
....................    #define lcd_output_enable(x) lcdlat.enable=x 
....................    #define lcd_enable_tris()   lcdtris.enable=0 
.................... #else 
....................    #define lcd_output_enable(x) output_bit(LCD_ENABLE_PIN, x) 
....................    #define lcd_enable_tris()  output_drive(LCD_ENABLE_PIN) 
.................... #endif 
....................  
.................... #ifndef LCD_RS_PIN 
....................    #define lcd_output_rs(x) lcdlat.rs=x 
....................    #define lcd_rs_tris()   lcdtris.rs=0 
.................... #else 
....................    #define lcd_output_rs(x) output_bit(LCD_RS_PIN, x) 
....................    #define lcd_rs_tris()  output_drive(LCD_RS_PIN) 
.................... #endif 
....................  
.................... #ifndef LCD_RW_PIN 
....................    #define lcd_output_rw(x) lcdlat.rw=x 
....................    #define lcd_rw_tris()   lcdtris.rw=0 
.................... #else 
....................    #define lcd_output_rw(x) output_bit(LCD_RW_PIN, x) 
....................    #define lcd_rw_tris()  output_drive(LCD_RW_PIN) 
.................... #endif 
....................  
.................... // original version of this library incorrectly labeled LCD_DATA0 as LCD_DATA4, 
.................... // LCD_DATA1 as LCD_DATA5, and so on.  this block of code makes the driver 
.................... // compatible with any code written for the original library 
.................... #if (defined(LCD_DATA0) && defined(LCD_DATA1) && defined(LCD_DATA2) && defined(LCD_DATA3) && !defined(LCD_DATA4) && !defined(LCD_DATA5) && !defined(LCD_DATA6) && !defined(LCD_DATA7)) 
....................    #define  LCD_DATA4    LCD_DATA0 
....................    #define  LCD_DATA5    LCD_DATA1 
....................    #define  LCD_DATA6    LCD_DATA2 
....................    #define  LCD_DATA7    LCD_DATA3 
.................... #endif 
....................  
.................... #ifndef LCD_DATA4 
.................... #ifndef LCD_DATA_PORT 
....................    #if defined(__PCB__) 
....................       #define LCD_DATA_PORT      0x06     //portb 
....................       #define set_tris_lcd(x)   set_tris_b(x) 
....................    #else 
....................      #if defined(PIN_D0) 
....................       #define LCD_DATA_PORT      getenv("SFR:PORTD")     //portd 
....................      #else 
....................       #define LCD_DATA_PORT      getenv("SFR:PORTB")     //portb 
....................      #endif 
....................    #endif    
.................... #endif 
....................  
.................... #if defined(__PCB__) 
....................    LCD_PIN_MAP lcd, lcdlat; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT 
.................... #elif defined(__PCM__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT 
....................    #byte lcdtris = LCD_DATA_PORT+0x80 
.................... #elif defined(__PCH__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #byte lcd = LCD_DATA_PORT 
....................    #byte lcdlat = LCD_DATA_PORT+9 
....................    #byte lcdtris = LCD_DATA_PORT+0x12 
.................... #elif defined(__PCD__) 
....................    LCD_PIN_MAP lcd, lcdlat, lcdtris; 
....................    #word lcd = LCD_DATA_PORT 
....................    #word lcdlat = LCD_DATA_PORT+2 
....................    #word lcdtris = LCD_DATA_PORT-0x02 
.................... #endif 
.................... #endif   //LCD_DATA4 not defined 
....................  
.................... #ifndef LCD_TYPE 
....................    #define LCD_TYPE 2           // 0=5x7, 1=5x10, 2=2 lines 
.................... #endif 
....................  
.................... #ifndef LCD_LINE_TWO 
....................    #define LCD_LINE_TWO 0x40    // LCD RAM address for the second line 
.................... #endif 
....................  
.................... #ifndef LCD_LINE_LENGTH 
....................    #define LCD_LINE_LENGTH 20 
.................... #endif 
....................  
.................... unsigned int8 lcd_read_nibble(void); 
....................  
.................... unsigned int8 lcd_read_byte(void) 
.................... { 
....................    unsigned int8 low,high; 
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_INPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_float(LCD_DATA4); 
*
00A7:  BSF    03.5
00A8:  BSF    06.4
....................    output_float(LCD_DATA5); 
00A9:  BSF    06.5
....................    output_float(LCD_DATA6); 
00AA:  BSF    06.6
....................    output_float(LCD_DATA7); 
00AB:  BSF    06.7
....................   #else 
....................    lcdtris.data = 0xF; 
....................   #endif 
....................  #endif 
....................          
....................    lcd_output_rw(1); 
00AC:  BCF    03.5
00AD:  BSF    06.2
....................    delay_cycles(1); 
00AE:  NOP
....................    lcd_output_enable(1); 
00AF:  BSF    06.3
....................    delay_cycles(1); 
00B0:  NOP
....................    high = lcd_read_nibble(); 
00B1:  CALL   07C
00B2:  MOVF   78,W
00B3:  MOVWF  48
....................        
....................    lcd_output_enable(0); 
00B4:  BCF    06.3
....................    delay_cycles(1); 
00B5:  NOP
....................    lcd_output_enable(1); 
00B6:  BSF    06.3
....................    delay_us(1); 
00B7:  NOP
....................    low = lcd_read_nibble(); 
00B8:  CALL   07C
00B9:  MOVF   78,W
00BA:  MOVWF  47
....................        
....................    lcd_output_enable(0); 
00BB:  BCF    06.3
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
00BC:  BSF    03.5
00BD:  BCF    06.4
....................    output_drive(LCD_DATA5); 
00BE:  BCF    06.5
....................    output_drive(LCD_DATA6); 
00BF:  BCF    06.6
....................    output_drive(LCD_DATA7); 
00C0:  BCF    06.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................  #endif 
....................  
....................    return( (high<<4) | low); 
00C1:  BCF    03.5
00C2:  SWAPF  48,W
00C3:  MOVWF  77
00C4:  MOVLW  F0
00C5:  ANDWF  77,F
00C6:  MOVF   77,W
00C7:  IORWF  47,W
00C8:  MOVWF  78
.................... } 
....................  
.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
*
007C:  CLRF   49
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
007D:  MOVLW  00
007E:  BTFSC  06.4
007F:  MOVLW  01
0080:  IORWF  49,F
....................    n |= input(LCD_DATA5) << 1; 
0081:  MOVLW  00
0082:  BTFSC  06.5
0083:  MOVLW  01
0084:  MOVWF  77
0085:  BCF    03.0
0086:  RLF    77,F
0087:  MOVF   77,W
0088:  IORWF  49,F
....................    n |= input(LCD_DATA6) << 2; 
0089:  MOVLW  00
008A:  BTFSC  06.6
008B:  MOVLW  01
008C:  MOVWF  77
008D:  RLF    77,F
008E:  RLF    77,F
008F:  MOVLW  FC
0090:  ANDWF  77,F
0091:  MOVF   77,W
0092:  IORWF  49,F
....................    n |= input(LCD_DATA7) << 3; 
0093:  MOVLW  00
0094:  BTFSC  06.7
0095:  MOVLW  01
0096:  MOVWF  77
0097:  RLF    77,F
0098:  RLF    77,F
0099:  RLF    77,F
009A:  MOVLW  F8
009B:  ANDWF  77,F
009C:  MOVF   77,W
009D:  IORWF  49,F
....................     
....................    return(n); 
009E:  MOVF   49,W
009F:  MOVWF  78
....................   #else 
00A0:  RETURN
....................    return(lcd.data); 
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
*
0063:  BTFSC  48.0
0064:  GOTO   067
0065:  BCF    06.4
0066:  GOTO   068
0067:  BSF    06.4
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
0068:  BTFSC  48.1
0069:  GOTO   06C
006A:  BCF    06.5
006B:  GOTO   06D
006C:  BSF    06.5
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
006D:  BTFSC  48.2
006E:  GOTO   071
006F:  BCF    06.6
0070:  GOTO   072
0071:  BSF    06.6
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
0072:  BTFSC  48.3
0073:  GOTO   076
0074:  BCF    06.7
0075:  GOTO   077
0076:  BSF    06.7
....................   #else       
....................    lcdlat.data = n; 
....................   #endif 
....................        
....................    delay_cycles(1); 
0077:  NOP
....................    lcd_output_enable(1); 
0078:  BSF    06.3
....................    delay_us(2); 
0079:  GOTO   07A
....................    lcd_output_enable(0); 
007A:  BCF    06.3
007B:  RETURN
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
00A1:  BSF    03.5
00A2:  BCF    06.3
....................    lcd_rs_tris(); 
00A3:  BCF    06.1
....................    lcd_rw_tris(); 
00A4:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
00A5:  BCF    03.5
00A6:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
00C9:  MOVF   78,W
00CA:  MOVWF  47
00CB:  BTFSC  47.7
00CC:  GOTO   0A7
....................    lcd_output_rs(address); 
00CD:  MOVF   45,F
00CE:  BTFSS  03.2
00CF:  GOTO   0D2
00D0:  BCF    06.1
00D1:  GOTO   0D3
00D2:  BSF    06.1
....................    delay_cycles(1); 
00D3:  NOP
....................    lcd_output_rw(0); 
00D4:  BCF    06.2
....................    delay_cycles(1); 
00D5:  NOP
....................    lcd_output_enable(0); 
00D6:  BCF    06.3
....................    lcd_send_nibble(n >> 4); 
00D7:  SWAPF  46,W
00D8:  MOVWF  47
00D9:  MOVLW  0F
00DA:  ANDWF  47,F
00DB:  MOVF   47,W
00DC:  MOVWF  48
00DD:  CALL   063
....................    lcd_send_nibble(n & 0xf); 
00DE:  MOVF   46,W
00DF:  ANDLW  0F
00E0:  MOVWF  47
00E1:  MOVWF  48
00E2:  CALL   063
00E3:  RETURN
.................... } 
....................  
.................... #if defined(LCD_EXTENDED_NEWLINE) 
.................... unsigned int8 g_LcdX, g_LcdY; 
.................... #endif 
....................  
.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
*
0130:  MOVLW  28
0131:  MOVWF  3B
0132:  MOVLW  0C
0133:  MOVWF  3C
0134:  MOVLW  01
0135:  MOVWF  3D
0136:  MOVLW  06
0137:  MOVWF  3E
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
0138:  BCF    06.3
....................    lcd_output_rs(0); 
0139:  BCF    06.1
....................    lcd_output_rw(0); 
013A:  BCF    06.2
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
013B:  BSF    03.5
013C:  BCF    06.4
....................    output_drive(LCD_DATA5); 
013D:  BCF    06.5
....................    output_drive(LCD_DATA6); 
013E:  BCF    06.6
....................    output_drive(LCD_DATA7); 
013F:  BCF    06.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................    lcd_enable_tris(); 
0140:  BCF    06.3
....................    lcd_rs_tris(); 
0141:  BCF    06.1
....................    lcd_rw_tris(); 
0142:  BCF    06.2
....................  #endif 
....................      
....................    delay_ms(15); 
0143:  MOVLW  0F
0144:  BCF    03.5
0145:  MOVWF  44
0146:  CALL   04E
....................    for(i=1;i<=3;++i) 
0147:  MOVLW  01
0148:  MOVWF  3A
0149:  MOVF   3A,W
014A:  SUBLW  03
014B:  BTFSS  03.0
014C:  GOTO   155
....................    { 
....................        lcd_send_nibble(3); 
014D:  MOVLW  03
014E:  MOVWF  48
014F:  CALL   063
....................        delay_ms(5); 
0150:  MOVLW  05
0151:  MOVWF  44
0152:  CALL   04E
0153:  INCF   3A,F
0154:  GOTO   149
....................    } 
....................     
....................    lcd_send_nibble(2); 
0155:  MOVLW  02
0156:  MOVWF  48
0157:  CALL   063
....................    delay_ms(5); 
0158:  MOVLW  05
0159:  MOVWF  44
015A:  CALL   04E
....................    for(i=0;i<=3;++i) 
015B:  CLRF   3A
015C:  MOVF   3A,W
015D:  SUBLW  03
015E:  BTFSS  03.0
015F:  GOTO   16C
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
0160:  MOVLW  3B
0161:  ADDWF  3A,W
0162:  MOVWF  04
0163:  BCF    03.7
0164:  MOVF   00,W
0165:  MOVWF  3F
0166:  CLRF   45
0167:  MOVF   3F,W
0168:  MOVWF  46
0169:  CALL   0A1
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
016A:  INCF   3A,F
016B:  GOTO   15C
....................    g_LcdX = 0; 
....................    g_LcdY = 0; 
....................   #endif 
.................... } 
....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
*
00E4:  DECFSZ 42,W
00E5:  GOTO   0E7
00E6:  GOTO   0EA
....................       address=LCD_LINE_TWO; 
00E7:  MOVLW  40
00E8:  MOVWF  43
00E9:  GOTO   0EB
....................    else 
....................       address=0; 
00EA:  CLRF   43
....................       
....................    address+=x-1; 
00EB:  MOVLW  01
00EC:  SUBWF  41,W
00ED:  ADDWF  43,F
....................    lcd_send_byte(0,0x80|address); 
00EE:  MOVF   43,W
00EF:  IORLW  80
00F0:  MOVWF  44
00F1:  CLRF   45
00F2:  MOVF   44,W
00F3:  MOVWF  46
00F4:  CALL   0A1
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
00F5:  RETURN
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
00F6:  MOVF   40,W
00F7:  XORLW  07
00F8:  BTFSC  03.2
00F9:  GOTO   104
00FA:  XORLW  0B
00FB:  BTFSC  03.2
00FC:  GOTO   109
00FD:  XORLW  06
00FE:  BTFSC  03.2
00FF:  GOTO   111
0100:  XORLW  02
0101:  BTFSC  03.2
0102:  GOTO   117
0103:  GOTO   11C
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
0104:  MOVLW  01
0105:  MOVWF  41
0106:  MOVWF  42
0107:  CALL   0E4
0108:  GOTO   121
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
0109:  CLRF   45
010A:  MOVLW  01
010B:  MOVWF  46
010C:  CALL   0A1
....................                      delay_ms(2); 
010D:  MOVLW  02
010E:  MOVWF  44
010F:  CALL   04E
....................                     #if defined(LCD_EXTENDED_NEWLINE) 
....................                      g_LcdX = 0; 
....................                      g_LcdY = 0; 
....................                     #endif 
....................                      break; 
0110:  GOTO   121
....................  
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       case '\r'   :  lcd_gotoxy(1, g_LcdY+1);   break; 
....................       case '\n'   : 
....................          while (g_LcdX++ < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, ' '); 
....................          } 
....................          lcd_gotoxy(1, g_LcdY+2); 
....................          break; 
....................      #else 
....................       case '\n'   : lcd_gotoxy(1,2);        break; 
0111:  MOVLW  01
0112:  MOVWF  41
0113:  MOVLW  02
0114:  MOVWF  42
0115:  CALL   0E4
0116:  GOTO   121
....................      #endif 
....................       
....................       case '\b'   : lcd_send_byte(0,0x10);  break; 
0117:  CLRF   45
0118:  MOVLW  10
0119:  MOVWF  46
011A:  CALL   0A1
011B:  GOTO   121
....................       
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       default     :  
....................          if (g_LcdX < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, c); 
....................             g_LcdX++; 
....................          } 
....................          break; 
....................      #else 
....................       default     : lcd_send_byte(1,c);     break; 
011C:  MOVLW  01
011D:  MOVWF  45
011E:  MOVF   40,W
011F:  MOVWF  46
0120:  CALL   0A1
....................      #endif 
....................    } 
0121:  RETURN
.................... } 
....................   
.................... char lcd_getc(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    char value; 
....................  
....................    lcd_gotoxy(x,y); 
....................    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low 
....................    lcd_output_rs(1); 
....................    value = lcd_read_byte(); 
....................    lcd_output_rs(0); 
....................     
....................    return(value); 
.................... } 
....................  
.................... // write a custom character to the ram 
.................... // which is 0-7 and specifies which character array we are modifying. 
.................... // ptr points to an array of 8 bytes, where each byte is the next row of 
.................... //    pixels.  only bits 0-4 are used.  the last row is the cursor row, and 
.................... //    usually you will want to leave this byte 0x00. 
.................... void lcd_set_cgram_char(unsigned int8 which, unsigned int8 *ptr) 
.................... { 
....................    unsigned int i; 
....................  
....................    which <<= 3; 
....................    which &= 0x38; 
....................  
....................    lcd_send_byte(0, 0x40 | which);  //set cgram address 
....................  
....................    for(i=0; i<8; i++) 
....................    { 
....................       lcd_send_byte(1, *ptr++); 
....................    } 
....................    
....................    #if defined(LCD_EXTENDED_NEWLINE) 
....................     lcd_gotoxy(g_LcdX+1, g_LcdY+1);  //set ddram address 
....................    #endif 
.................... } 
....................  
.................... void lcd_cursor_on(int1 on) 
.................... { 
....................    if (on) 
....................    { 
....................       lcd_send_byte(0,0x0F);           //turn LCD cursor ON 
....................    } 
....................    else 
....................    { 
....................       lcd_send_byte(0,0x0C);           //turn LCD cursor OFF 
....................    } 
.................... } 
....................  
.................... #endif 
....................  
....................  
....................  
.................... enum MenuState { 
....................    IDLE = 0, 
....................    SET_SECOND, 
....................    SET_MINUTE, 
....................    SET_HOUR, 
....................    SET_DAY, 
....................    SET_DATE, 
....................    SET_MONTH, 
....................    SET_YEAR, 
....................    SAVE_AND_EXIT 
.................... }; 
....................  
.................... volatile enum MenuState menu_state = IDLE; 
....................  
.................... // Interrupt service routine 
....................  
.................... #int_ext 
.................... void isrext() {        
....................    menu_state++; 
*
0044:  INCF   39,F
....................    if (menu_state > SAVE_AND_EXIT) 
0045:  MOVF   39,W
0046:  SUBLW  08
0047:  BTFSS  03.0
....................       menu_state = IDLE; 
0048:  CLRF   39
....................    clear_interrupt(INT_EXT);   
0049:  BCF    0B.1
004A:  BCF    0B.1
004B:  BCF    0A.3
004C:  BCF    0A.4
004D:  GOTO   01B
.................... } 
....................  
.................... void sys_init(){ 
....................    output_a(0); 
*
0122:  CLRF   05
....................    output_b(0); 
0123:  CLRF   06
....................    output_c(0); 
0124:  CLRF   07
....................    set_tris_a(0b111111); 
0125:  MOVLW  3F
0126:  BSF    03.5
0127:  MOVWF  05
....................    set_tris_b(0x01); 
0128:  MOVLW  01
0129:  MOVWF  06
....................    set_tris_c(0); 
012A:  MOVLW  00
012B:  MOVWF  07
....................    output_a(0); 
012C:  BCF    03.5
012D:  CLRF   05
....................    output_b(0); 
012E:  CLRF   06
....................    output_c(0); 
012F:  CLRF   07
....................     
....................    lcd_init(); 
....................    lcd_putc('\f'); 
*
016C:  MOVLW  0C
016D:  MOVWF  40
016E:  CALL   0F6
....................     
....................    ext_int_edge(L_TO_H); 
016F:  BSF    03.5
0170:  BSF    01.6
....................    clear_interrupt(INT_EXT); 
0171:  BCF    03.5
0172:  BCF    0B.1
....................    enable_interrupts(INT_EXT); 
0173:  BSF    0B.4
....................    enable_interrupts(GLOBAL); 
0174:  MOVLW  C0
0175:  IORWF  0B,F
0176:  BSF    0A.3
0177:  BCF    0A.4
0178:  GOTO   0A1 (RETURN)
.................... } 
