#include "interupt.h"


void main()
{
   sys();
   while(TRUE)
   {
      if(!flag) run_interrupt();
      output_high(PIN_A0);
      if(!flag) run_interrupt();
      delay_ms(1000);
      if(!flag) run_interrupt();
      output_low(PIN_A0);
      if(!flag) run_interrupt();
      delay_ms(1000);
      
   }
}

