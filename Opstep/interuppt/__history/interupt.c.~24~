#include <interupt.h>

void run_interrupt(void){
   unsigned int8 y = 0;
   for(y = 0; y < 7; y++){
      output_high(pin_b7);
      delay_ms(500);
      output_low(pin_b7);
      delay_ms(500);
   }
}

void main()
{

   output_a(0);
   output_b(0);
   set_tris_a(0b00000);
   set_tris_b(0b00000001);
   output_a(0);
   output_b(0);
   clear_interrupt(int_ext);
   ext_int_edge(h_to_l);
   enable_interrupts(int_ext);
   enable_interrupts(global);
   
   //unsigned int8 y;
   
   
   while(TRUE)
   {
       if (int_flag) {
        run_interrupt();
         int_flag = 1;
      }
      output_high(pin_a0);
      delay_ms(1000);
      output_low(pin_a0);
      delay_ms(1000);
      
   }

}
