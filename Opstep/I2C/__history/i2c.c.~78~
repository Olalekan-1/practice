#include <i2c.h>

void main()
{

   sys_init();
   y = read_eeprom(5);  
    if(y == 255){
      write_eeprom(5, 0);
      delay_ms(100);
      write_eeprom(0, 0);
      delay_ms(100);
      write_eeprom(1, 0);
      delay_ms(100);
     }

   while(TRUE)
   {  
   
     
      if(!input(STORE)){
      while(!input(STORE));
      temp = READ_ADC();
      write_eeprom_i2c(temp);
      
      lcd_gotoxy(1, 1);
      printf(lcd_putc, "%u %cC" temp, 223);
      delay_ms(100);
     }
     
   
     if(!input(RECALL)){
      while(!input(RECALL));
      high = read_eeprom(1);
      low = read_eeprom(0);
      total_mem_read = make16(high, low);
      for(i = 0; i <( total_mem_read - 1) ; i++){
         temp = i2c_eeprom_read(make8(i,1), make8(i, 0));
         lcd_putc('\f');
         printf(lcd_putc, "%u %cC" temp, 223);
         delay_ms(3000);   
      }
   }


}
}
