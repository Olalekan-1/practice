01C3:  CALL   13E
....................    i2c_stop(); 
01C4:  BSF    03.5
01C5:  BCF    07.4
01C6:  NOP
01C7:  BSF    07.3
01C8:  BCF    03.5
01C9:  BTFSS  07.3
01CA:  GOTO   1C9
01CB:  NOP
01CC:  GOTO   1CD
01CD:  NOP
01CE:  BSF    03.5
01CF:  BSF    07.4
01D0:  NOP
....................    delay_ms(5); 
01D1:  MOVLW  05
01D2:  BCF    03.5
01D3:  MOVWF  31
01D4:  CALL   004
.................... } 
....................  
