.................... unsigned int8 lcd_read_nibble(void) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
*
0032:  CLRF   36
....................    unsigned int8 n = 0x00; 
....................  
....................    /* Read the data port */ 
....................    n |= input(LCD_DATA4); 
0033:  MOVLW  00
0034:  BTFSC  06.4
0035:  MOVLW  01
0036:  IORWF  36,F
....................    n |= input(LCD_DATA5) << 1; 
0037:  MOVLW  00
0038:  BTFSC  06.5
0039:  MOVLW  01
003A:  MOVWF  77
003B:  BCF    03.0
003C:  RLF    77,F
003D:  MOVF   77,W
003E:  IORWF  36,F
....................    n |= input(LCD_DATA6) << 2; 
003F:  MOVLW  00
0040:  BTFSC  06.6
0041:  MOVLW  01
0042:  MOVWF  77
0043:  RLF    77,F
0044:  RLF    77,F
0045:  MOVLW  FC
0046:  ANDWF  77,F
0047:  MOVF   77,W
0048:  IORWF  36,F
....................    n |= input(LCD_DATA7) << 3; 
0049:  MOVLW  00
004A:  BTFSC  06.7
004B:  MOVLW  01
004C:  MOVWF  77
004D:  RLF    77,F
004E:  RLF    77,F
004F:  RLF    77,F
0050:  MOVLW  F8
0051:  ANDWF  77,F
0052:  MOVF   77,W
0053:  IORWF  36,F
....................     
....................    return(n); 
0054:  MOVF   36,W
0055:  MOVWF  78
....................   #else 
0056:  RETURN
....................    return(lcd.data); 
....................   #endif 
.................... } 
....................  
.................... void lcd_send_nibble(unsigned int8 n) 
.................... { 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    /* Write to the data port */ 
....................    output_bit(LCD_DATA4, bit_test(n, 0)); 
*
0019:  BTFSC  35.0
001A:  GOTO   01D
001B:  BCF    06.4
001C:  GOTO   01E
001D:  BSF    06.4
....................    output_bit(LCD_DATA5, bit_test(n, 1)); 
001E:  BTFSC  35.1
001F:  GOTO   022
0020:  BCF    06.5
0021:  GOTO   023
0022:  BSF    06.5
....................    output_bit(LCD_DATA6, bit_test(n, 2)); 
0023:  BTFSC  35.2
0024:  GOTO   027
0025:  BCF    06.6
0026:  GOTO   028
0027:  BSF    06.6
....................    output_bit(LCD_DATA7, bit_test(n, 3)); 
0028:  BTFSC  35.3
0029:  GOTO   02C
002A:  BCF    06.7
002B:  GOTO   02D
002C:  BSF    06.7
....................   #else       
....................    lcdlat.data = n; 
....................   #endif 
....................        
....................    delay_cycles(1); 
002D:  NOP
....................    lcd_output_enable(1); 
002E:  BSF    06.3
....................    delay_us(2); 
002F:  GOTO   030
....................    lcd_output_enable(0); 
0030:  BCF    06.3
0031:  RETURN
.................... } 
....................  
.................... void lcd_send_byte(unsigned int8 address, unsigned int8 n) 
.................... { 
....................   #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................   #else 
....................    lcd_enable_tris(); 
*
0057:  BSF    03.5
0058:  BCF    06.3
....................    lcd_rs_tris(); 
0059:  BCF    06.1
....................    lcd_rw_tris(); 
005A:  BCF    06.2
....................   #endif 
....................  
....................    lcd_output_rs(0); 
005B:  BCF    03.5
005C:  BCF    06.1
....................    while ( bit_test(lcd_read_byte(),7) ) ; 
*
007F:  MOVF   78,W
0080:  MOVWF  34
0081:  BTFSC  34.7
0082:  GOTO   05D
....................    lcd_output_rs(address); 
0083:  MOVF   32,F
0084:  BTFSS  03.2
0085:  GOTO   088
0086:  BCF    06.1
0087:  GOTO   089
0088:  BSF    06.1
....................    delay_cycles(1); 
0089:  NOP
....................    lcd_output_rw(0); 
008A:  BCF    06.2
....................    delay_cycles(1); 
008B:  NOP
....................    lcd_output_enable(0); 
008C:  BCF    06.3
....................    lcd_send_nibble(n >> 4); 
008D:  SWAPF  33,W
008E:  MOVWF  34
008F:  MOVLW  0F
0090:  ANDWF  34,F
0091:  MOVF   34,W
0092:  MOVWF  35
0093:  CALL   019
....................    lcd_send_nibble(n & 0xf); 
0094:  MOVF   33,W
0095:  ANDLW  0F
0096:  MOVWF  34
0097:  MOVWF  35
0098:  CALL   019
0099:  RETURN
.................... } 
....................  
.................... #if defined(LCD_EXTENDED_NEWLINE) 
.................... unsigned int8 g_LcdX, g_LcdY; 
.................... #endif 
....................  
.................... void lcd_init(void)  
.................... { 
....................    unsigned int8 i; 
....................    unsigned int8 LCD_INIT_STRING[4] = {0x20 | (LCD_TYPE << 2), 0xc, 1, 6}; 
*
00FC:  MOVLW  28
00FD:  MOVWF  2C
00FE:  MOVLW  0C
00FF:  MOVWF  2D
0100:  MOVLW  01
0101:  MOVWF  2E
0102:  MOVLW  06
0103:  MOVWF  2F
....................                              // These bytes need to be sent to the LCD 
....................                              // to start it up. 
....................     
....................  
....................    lcd_output_enable(0); 
0104:  BCF    06.3
....................    lcd_output_rs(0); 
0105:  BCF    06.1
....................    lcd_output_rw(0); 
0106:  BCF    06.2
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
0107:  BSF    03.5
0108:  BCF    06.4
....................    output_drive(LCD_DATA5); 
0109:  BCF    06.5
....................    output_drive(LCD_DATA6); 
010A:  BCF    06.6
....................    output_drive(LCD_DATA7); 
010B:  BCF    06.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................    lcd_enable_tris(); 
010C:  BCF    06.3
....................    lcd_rs_tris(); 
010D:  BCF    06.1
....................    lcd_rw_tris(); 
010E:  BCF    06.2
....................  #endif 
....................      
....................    delay_ms(15); 
010F:  MOVLW  0F
0110:  BCF    03.5
0111:  MOVWF  31
0112:  CALL   004
....................    for(i=1;i<=3;++i) 
0113:  MOVLW  01
0114:  MOVWF  2B
0115:  MOVF   2B,W
0116:  SUBLW  03
0117:  BTFSS  03.0
0118:  GOTO   121
....................    { 
....................        lcd_send_nibble(3); 
0119:  MOVLW  03
011A:  MOVWF  35
011B:  CALL   019
....................        delay_ms(5); 
011C:  MOVLW  05
011D:  MOVWF  31
011E:  CALL   004
011F:  INCF   2B,F
0120:  GOTO   115
....................    } 
....................     
....................    lcd_send_nibble(2); 
0121:  MOVLW  02
0122:  MOVWF  35
0123:  CALL   019
....................    delay_ms(5); 
0124:  MOVLW  05
0125:  MOVWF  31
0126:  CALL   004
....................    for(i=0;i<=3;++i) 
0127:  CLRF   2B
0128:  MOVF   2B,W
0129:  SUBLW  03
012A:  BTFSS  03.0
012B:  GOTO   138
....................       lcd_send_byte(0,LCD_INIT_STRING[i]); 
012C:  MOVLW  2C
012D:  ADDWF  2B,W
012E:  MOVWF  04
012F:  BCF    03.7
0130:  MOVF   00,W
0131:  MOVWF  30
0132:  CLRF   32
0133:  MOVF   30,W
0134:  MOVWF  33
0135:  CALL   057
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
0136:  INCF   2B,F
0137:  GOTO   128
....................    g_LcdX = 0; 
....................    g_LcdY = 0; 
....................   #endif 
.................... } 
....................  
.................... void lcd_gotoxy(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    unsigned int8 address; 
....................     
....................    if(y!=1) 
*
009A:  DECFSZ 2F,W
009B:  GOTO   09D
009C:  GOTO   0A0
....................       address=LCD_LINE_TWO; 
009D:  MOVLW  40
009E:  MOVWF  30
009F:  GOTO   0A1
....................    else 
....................       address=0; 
00A0:  CLRF   30
....................       
....................    address+=x-1; 
00A1:  MOVLW  01
00A2:  SUBWF  2E,W
00A3:  ADDWF  30,F
....................    lcd_send_byte(0,0x80|address); 
00A4:  MOVF   30,W
00A5:  IORLW  80
00A6:  MOVWF  31
00A7:  CLRF   32
00A8:  MOVF   31,W
00A9:  MOVWF  33
00AA:  CALL   057
....................  
....................   #if defined(LCD_EXTENDED_NEWLINE) 
00AB:  RETURN
....................    g_LcdX = x - 1; 
....................    g_LcdY = y - 1; 
....................   #endif 
.................... } 
....................  
.................... void lcd_putc(char c) 
.................... { 
....................    switch (c) 
00AC:  MOVF   2D,W
00AD:  XORLW  07
00AE:  BTFSC  03.2
00AF:  GOTO   0BA
00B0:  XORLW  0B
00B1:  BTFSC  03.2
00B2:  GOTO   0BF
00B3:  XORLW  06
00B4:  BTFSC  03.2
00B5:  GOTO   0C7
00B6:  XORLW  02
00B7:  BTFSC  03.2
00B8:  GOTO   0CD
00B9:  GOTO   0D2
....................    { 
....................       case '\a'   :  lcd_gotoxy(1,1);     break; 
00BA:  MOVLW  01
00BB:  MOVWF  2E
00BC:  MOVWF  2F
00BD:  CALL   09A
00BE:  GOTO   0D7
....................  
....................       case '\f'   :  lcd_send_byte(0,1); 
00BF:  CLRF   32
00C0:  MOVLW  01
00C1:  MOVWF  33
00C2:  CALL   057
....................                      delay_ms(2); 
00C3:  MOVLW  02
00C4:  MOVWF  31
00C5:  CALL   004
....................                     #if defined(LCD_EXTENDED_NEWLINE) 
....................                      g_LcdX = 0; 
....................                      g_LcdY = 0; 
....................                     #endif 
....................                      break; 
00C6:  GOTO   0D7
....................  
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       case '\r'   :  lcd_gotoxy(1, g_LcdY+1);   break; 
....................       case '\n'   : 
....................          while (g_LcdX++ < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, ' '); 
....................          } 
....................          lcd_gotoxy(1, g_LcdY+2); 
....................          break; 
....................      #else 
....................       case '\n'   : lcd_gotoxy(1,2);        break; 
00C7:  MOVLW  01
00C8:  MOVWF  2E
00C9:  MOVLW  02
00CA:  MOVWF  2F
00CB:  CALL   09A
00CC:  GOTO   0D7
....................      #endif 
....................       
....................       case '\b'   : lcd_send_byte(0,0x10);  break; 
00CD:  CLRF   32
00CE:  MOVLW  10
00CF:  MOVWF  33
00D0:  CALL   057
00D1:  GOTO   0D7
....................       
....................      #if defined(LCD_EXTENDED_NEWLINE) 
....................       default     :  
....................          if (g_LcdX < LCD_LINE_LENGTH) 
....................          { 
....................             lcd_send_byte(1, c); 
....................             g_LcdX++; 
....................          } 
....................          break; 
....................      #else 
....................       default     : lcd_send_byte(1,c);     break; 
00D2:  MOVLW  01
00D3:  MOVWF  32
00D4:  MOVF   2D,W
00D5:  MOVWF  33
00D6:  CALL   057
....................      #endif 
....................    } 
00D7:  RETURN
.................... } 
....................   
.................... char lcd_getc(unsigned int8 x, unsigned int8 y) 
.................... { 
....................    char value; 
....................  
....................    lcd_gotoxy(x,y); 
....................    while ( bit_test(lcd_read_byte(),7) ); // wait until busy flag is low 
....................    lcd_output_rs(1); 
....................    value = lcd_read_byte(); 
....................    lcd_output_rs(0); 
....................     
....................    return(value); 
.................... } 
....................  
.................... // write a custom character to the ram 
.................... // which is 0-7 and specifies which character array we are modifying. 
.................... // ptr points to an array of 8 bytes, where each byte is the next row of 
.................... //    pixels.  only bits 0-4 are used.  the last row is the cursor row, and 
.................... //    usually you will want to leave this byte 0x00. 
.................... void lcd_set_cgram_char(unsigned int8 which, unsigned int8 *ptr) 
.................... { 
....................    unsigned int i; 
....................  
....................    which <<= 3; 
....................    which &= 0x38; 
....................  
....................    lcd_send_byte(0, 0x40 | which);  //set cgram address 
....................  
....................    for(i=0; i<8; i++) 
....................    { 
....................       lcd_send_byte(1, *ptr++); 
....................    } 
....................    
....................    #if defined(LCD_EXTENDED_NEWLINE) 
....................     lcd_gotoxy(g_LcdX+1, g_LcdY+1);  //set ddram address 
....................    #endif 
.................... } 
....................  
.................... void lcd_cursor_on(int1 on) 
.................... { 
....................    if (on) 
....................    { 
....................       lcd_send_byte(0,0x0F);           //turn LCD cursor ON 
....................    } 
....................    else 
....................    { 
....................       lcd_send_byte(0,0x0C);           //turn LCD cursor OFF 
....................    } 
.................... } 
....................  
.................... #endif 
....................  
....................  
....................  
....................  
....................  
....................  
....................  
.................... void sys_init(){ 
....................    output_a(0); 
00D8:  CLRF   05
....................    output_b(0); 
00D9:  CLRF   06
....................    output_c(0); 
00DA:  CLRF   07
....................    set_tris_a(0b111111); 
00DB:  MOVLW  3F
00DC:  BSF    03.5
00DD:  MOVWF  05
....................    set_tris_b(0); 
00DE:  MOVLW  00
00DF:  MOVWF  06
....................    set_tris_c(0); 
00E0:  MOVWF  07
....................    output_a(0); 
00E1:  BCF    03.5
00E2:  CLRF   05
....................    output_b(0); 
00E3:  CLRF   06
....................    output_c(0); 
00E4:  CLRF   07
....................     
....................    SETUP_ADC(ADC_CLOCK_INTERNAL); 
00E5:  BSF    03.5
00E6:  BCF    1F.6
00E7:  BCF    03.5
00E8:  BSF    1F.6
00E9:  BSF    1F.7
00EA:  BSF    03.5
00EB:  BCF    1F.7
00EC:  BCF    03.5
00ED:  BSF    1F.0
....................    SETUP_ADC_PORTS(AN0_AN1_VSS_VREF); 
00EE:  BSF    03.5
00EF:  BSF    1F.0
00F0:  BCF    1F.1
00F1:  BSF    1F.2
00F2:  BCF    1F.3
....................    SET_ADC_CHANNEL(0); 
00F3:  MOVWF  78
00F4:  BCF    03.5
00F5:  MOVF   1F,W
00F6:  ANDLW  C7
00F7:  IORWF  78,W
00F8:  MOVWF  1F
....................    delay_ms(100); 
00F9:  MOVLW  64
00FA:  MOVWF  31
00FB:  CALL   004
....................     
....................    lcd_init(); 
....................    lcd_putc('\f'); 
*
0138:  MOVLW  0C
0139:  MOVWF  2D
013A:  CALL   0AC
013B:  BCF    0A.3
013C:  BCF    0A.4
013D:  GOTO   302 (RETURN)
....................     
.................... } 
....................  
.................... void lcd_line(int8 line){ 
....................  
....................    lcd_gotoxy(1,line); 
.................... } 
....................  
.................... void i2c_eeprom_write(unsigned int8 addrh, unsigned int8 addrl, char data){ 
....................    i2c_start(); 
*
01A9:  BSF    03.5
01AA:  BSF    07.4
01AB:  NOP
01AC:  BSF    07.3
01AD:  NOP
01AE:  BCF    03.5
01AF:  BCF    07.4
01B0:  BSF    03.5
01B1:  BCF    07.4
01B2:  NOP
01B3:  BCF    03.5
01B4:  BCF    07.3
01B5:  BSF    03.5
01B6:  BCF    07.3
....................    i2c_write(0xA0); 
