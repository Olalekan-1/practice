....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_float(LCD_DATA4); 
*
005D:  BSF    03.5
005E:  BSF    06.4
....................    output_float(LCD_DATA5); 
005F:  BSF    06.5
....................    output_float(LCD_DATA6); 
0060:  BSF    06.6
....................    output_float(LCD_DATA7); 
0061:  BSF    06.7
....................   #else 
....................    lcdtris.data = 0xF; 
....................   #endif 
....................  #endif 
....................          
....................    lcd_output_rw(1); 
0062:  BCF    03.5
0063:  BSF    06.2
....................    delay_cycles(1); 
0064:  NOP
....................    lcd_output_enable(1); 
0065:  BSF    06.3
....................    delay_cycles(1); 
0066:  NOP
....................    high = lcd_read_nibble(); 
0067:  CALL   032
0068:  MOVF   78,W
0069:  MOVWF  35
....................        
....................    lcd_output_enable(0); 
006A:  BCF    06.3
....................    delay_cycles(1); 
006B:  NOP
....................    lcd_output_enable(1); 
006C:  BSF    06.3
....................    delay_us(1); 
006D:  NOP
....................    low = lcd_read_nibble(); 
006E:  CALL   032
006F:  MOVF   78,W
0070:  MOVWF  34
....................        
....................    lcd_output_enable(0); 
0071:  BCF    06.3
....................  
....................  #if defined(__PCB__) 
....................    set_tris_lcd(LCD_OUTPUT_MAP); 
....................  #else 
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7)) 
....................    output_drive(LCD_DATA4); 
0072:  BSF    03.5
0073:  BCF    06.4
....................    output_drive(LCD_DATA5); 
0074:  BCF    06.5
....................    output_drive(LCD_DATA6); 
0075:  BCF    06.6
....................    output_drive(LCD_DATA7); 
0076:  BCF    06.7
....................   #else 
....................    lcdtris.data = 0x0; 
....................   #endif 
....................  #endif 
....................  
....................    return( (high<<4) | low); 
