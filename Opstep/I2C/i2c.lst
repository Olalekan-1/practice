01B8:  BCF    03.5
01B9:  MOVWF  31
01BA:  CALL   13E
....................    i2c_write(addrh); 
01BB:  MOVF   2E,W
01BC:  MOVWF  31
01BD:  CALL   13E
....................    i2c_write(addrl); 
