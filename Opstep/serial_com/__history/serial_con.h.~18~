#include <16F876A.h>

#FUSES XT, NOWDT, PUT, NOBROWNOUT, NOLVP, CPD, NODEBUG, PROTECT
#use delay(crystal=4000000)
#use rs232(UART1)
#use rs232(baud=9600, parity=N, xmit=pin_a0, rcv=pin_a1, stream=LCD)

void sys(){
   output_a(0);
   output_b(0);
   output_c(0);
   set_tris_a(0b000010);
   set_tris_b(0);
   set_tris_c(0);
   output_a(0);
   output_b(0);
   output_c(0);
}

