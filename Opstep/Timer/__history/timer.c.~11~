void main()
{
   sys();
   while(TRUE)
   {
    if(input(inc)){
      while(input(inc));
      biggi++;
      if(biggi > 99) {
         biggi = 0;
       }
    }
    
    if(input(dec)){
      while(input(dec));
      biggi--;
      if((biggi < 1) || (biggi > 99)){
         biggi = 0;
      } 
    }
   }

}
