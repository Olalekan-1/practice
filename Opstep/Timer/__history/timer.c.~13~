#include "timer.h"

void main()
{
   sys();
   while(TRUE)
   {
    if(input(inc)){
      biggi++;
      if(biggi > 99) {
         biggi = 0;
       }
       while(input(inc));
    }
    
    if(input(dec)){
      biggi--;
      if((biggi < 1) || (biggi > 99)){
         biggi = 0;
      }
      while(input(dec));
    }
   }

}
