#include <adc.h>

void main(){
   sys(); 

   while(TRUE){
      var = read_adc()
      delay_ms(100);
      
      lcd_gotoxy(1,1);
      lcd_putc("ADC LINE 1);
      delay_ms(1000);
      lcd_putc('\n');
      lcd_gotoxy(1,2);
      lcd_putc(var);
      delay_ms(1000);
      
   }

}
