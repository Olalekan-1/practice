#include <adc.h>

void main(){
   sys();

   while(TRUE){
     
      
      lcd_gotoxy(1,1);
      lcd_putc("ADC LINE 1");
      delay_ms(1000);
      lcd_putc('\n');
      lcd_gotoxy(1,2);
      var = read_adc();
      delay_ms(100);
      
      volt = var * 0.0196;
      printf(lcd_putc "input = %w", volt);
      delay_ms(1000);
      
   }

}
